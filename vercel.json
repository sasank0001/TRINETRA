{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{model/**,templates/**,static/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
